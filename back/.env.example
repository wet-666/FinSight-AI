PORT=3300
JWT_SECRET=请换成随机长字符串
JWT_EXPIRES_IN=7d

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=MySQL密码
DB_NAME=FinSightAI

OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V3
# 轻量 RAG embedding（失败自动降级关键词检索）
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_TIMEOUT_MS=45000

# 可选备用（仅当主 OPENAI_API_KEY 为空时生效，不会自动 failover）
# OPENAI_API_KEY2=
# OPENAI_BASE_URL2=https://api.deepseek.com
# OPENAI_MODEL2=deepseek-chat

NEWS_CRON=0 */2 * * *
CLEANUP_CRON=0 3 * * *
NEWS_RETENTION_DAYS=90
SENTIMENT_AGGREGATE_RETENTION_DAYS=180

# 可选：行情短时缓存（Redis 未启动时自动跳过，不影响主流程）
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
# 报价/指数缓存秒数
REDIS_QUOTE_TTL=20
